# Browser-safe Supabase values. Keep service secrets server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_LINE_PROVIDER=custom:line

# Keep QA seed rows hidden unless explicitly testing against staging data.
ARENA_SHOW_QA_DATA=false

# Optional Google Maps fallback. The default map uses Leaflet + OpenStreetMap and needs no key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Vercel runtime: use the Supabase transaction pooler URL, for example:
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Local/CI migration connection; use the session pooler on port 5432.
# Never expose this to the browser.
MIGRATION_DATABASE_URL=

# Cloudflare R2 server-only credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
